{
	"name": "@kleri/ui",
	"version": "0.0.10",
	"description": "An opinionated SvelteKit UI component library for the kleri.org apps.",
	"license": "MIT",
	"author": "Ishaan Goel",
	"homepage": "https://ui.kleri.org",
	"bugs": "https://github.com/kleri-org/kleri-ui/issues",
	"engines": {
		"node": ">=22.17"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kleri-org/kleri-ui.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint && node -e \"import('fs').then(fs => fs.cpSync('src/lib/styles', 'dist/styles', { recursive: true }))\"",
		"prepack:watch": "svelte-package --watch",
		"check": "wrangler types --check && svelte-kit sync && rm -rf .svelte-kit/output .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && rm -rf .svelte-kit/output .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": {
			"default": "./dist/styles/kleri-ui.css"
		},
		"./preview": {
			"types": "./dist/preview/index.d.ts",
			"svelte": "./dist/preview/index.js"
		},
		"./tauri": {
			"types": "./dist/tauri/index.d.ts",
			"svelte": "./dist/tauri/index.js"
		},
		"./magic": {
			"types": "./dist/magic/index.d.ts",
			"svelte": "./dist/magic/index.js"
		},
		"./dragndrop": {
			"types": "./dist/input/dragndrop/index.d.ts",
			"svelte": "./dist/input/dragndrop/index.js"
		},
		"./popover": {
			"types": "./dist/menus/popover/index.d.ts",
			"svelte": "./dist/menus/popover/index.js"
		},
		"./calendar": {
			"types": "./dist/calendar/index.d.ts",
			"svelte": "./dist/calendar/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.20.0",
		"bits-ui": "^2.18.0",
		"@lucide/svelte": "^1.14.0",
		"tailwindcss": "^4.2.0",
		"daisyui": "^5.5.0",
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/plugin-dialog": "^2.0.0",
		"@tauri-apps/plugin-os": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/api": {
			"optional": true
		},
		"@tauri-apps/plugin-dialog": {
			"optional": true
		},
		"@tauri-apps/plugin-os": {
			"optional": true
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"motion-sv": "^0.2.2",
		"shiki": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.68.0",
		"@playwright/test": "^1.64.1",
		"@shikijs/langs": "^4.6.0",
		"@shikijs/themes": "^4.6.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"bits-ui": "^2.20.4",
		"daisyui": "^5.7.50",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"playwright": "^1.64.1",
		"playwright-core": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.157.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"ui",
		"components",
		"kleri",
		"tailwindcss",
		"daisyui",
		"calendar",
		"scheduling"
	]
}
