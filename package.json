{
	"name": "@kleri/ui",
	"version": "0.0.9",
	"description": "An opinionated SvelteKit UI component library for the kleri.org apps.",
	"license": "MIT",
	"author": "Ishaan Goel",
	"homepage": "https://ui.kleri.org",
	"bugs": "https://github.com/kleri-org/kleri-ui/issues",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kleri-org/kleri-ui"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint && node -e \"import('fs').then(fs => fs.cpSync('src/lib/styles', 'dist/styles', { recursive: true }))\"",
		"prepack:watch": "svelte-package --watch",
		"check": "wrangler types --check && svelte-kit sync && rm -rf .svelte-kit/output .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && rm -rf .svelte-kit/output .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": {
			"default": "./dist/styles/kleri-ui.css"
		},
		"./tauri": {
			"types": "./dist/tauri/index.d.ts",
			"svelte": "./dist/tauri/index.js"
		},
		"./magic": {
			"types": "./dist/magic/index.d.ts",
			"svelte": "./dist/magic/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"bits-ui": "^2.18.0",
		"@lucide/svelte": "^1.14.0",
		"tailwindcss": "^4.2.0",
		"daisyui": "^5.5.0",
		"@tauri-apps/api": "^2.0.0",
		"@tauri-apps/plugin-dialog": "^2.0.0",
		"@tauri-apps/plugin-os": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/api": {
			"optional": true
		},
		"@tauri-apps/plugin-dialog": {
			"optional": true
		},
		"@tauri-apps/plugin-os": {
			"optional": true
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"motion-sv": "^0.1.12",
		"shiki": "^4.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@playwright/test": "^1.60.0",
		"@shikijs/langs": "^4.1.0",
		"@shikijs/themes": "^4.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-os": "^2.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^25.9.1",
		"@vitest/browser-playwright": "^4.1.7",
		"@vitest/coverage-v8": "^4.1.7",
		"bits-ui": "^2.18.1",
		"daisyui": "^5.5.20",
		"eslint": "^10.4.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"happy-dom": "^20.9.0",
		"playwright": "^1.60.0",
		"playwright-core": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13",
		"vitest": "^4.1.7",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.93.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"ui",
		"components",
		"kleri",
		"tailwindcss",
		"daisyui"
	]
}
